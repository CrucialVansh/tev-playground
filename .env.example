# Together AI API key for together/Tev1-4B-experimental
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your_together_api_key_here

# TypeSafe API key for Jev (jev-latest)
# https://www.jevtypesafeai.com/
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional. Laya Core ML defaults to the local English bundle aac6fef/laya-coreml.
